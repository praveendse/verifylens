# Copy to .env for LOCAL development only:  cp .env.example .env && chmod 600 .env
# On a server, set these as real environment variables or secret files
# (see security/secrets.py) instead of shipping a .env file.

# --- Secrets (required) -------------------------------------------------
# Min 32 chars. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it logs everyone out (existing tokens stop working).
JWT_SECRET_KEY=
# From Google AI Studio. Without it the app starts but searches fail.
GEMINI_API_KEY=

# --- Optional settings (defaults shown) ---------------------------------
# GEMINI_MODEL=gemini-3.5-flash-lite
# HEADLESS=true
# DATABASE_PATH=data/search_history.db
# JWT_ACCESS_TOKEN_MINUTES=30
# LOGIN_ATTEMPTS_PER_IP_PER_MINUTE=10
# LOGIN_ATTEMPTS_PER_USERNAME_PER_MINUTE=5
# SEARCHES_PER_USER_PER_MINUTE=5
# SECRETS_DIR=/run/secrets
# Refresh-token sign-ins (HttpOnly cookie). See docs/specs/auth.md AUTH-12..18.
# REFRESH_TOKEN_IDLE_HOURS=8
# REFRESH_TOKEN_MAX_DAYS=7
# REFRESH_COOKIE_SECURE=true      # keep true; browsers accept it on http://localhost
# REFRESH_ATTEMPTS_PER_IP_PER_MINUTE=30

# --- Self-service password reset by email (off by default) ---------------
# Stays off unless enabled AND SMTP_HOST, SMTP_FROM and APP_BASE_URL are set.
# See docs/specs/password-recovery.md.
# PASSWORD_RESET_ENABLED=false
# PASSWORD_RESET_TOKEN_MINUTES=15
# APP_BASE_URL=https://verifylens.internal.example   # public address of the app; used in reset links
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_STARTTLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=                                     # secret: prefer a secret file on servers
# SMTP_FROM=
